// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

model User {
  id         Int     @id @default(autoincrement())
  email      String  @unique
  password   String?
  name       String
  visitCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tossAccount       TossAccount?
  oauthAccounts     OAuth[]
  orders            Order[]
  trades            Trade[]
  diaries           Diary[]
  virtualPortfolios VirtualPortfolio[]

  /// VirtualPortfolioStock.userId의 역방향. 종목을 사용자당 한 계좌에만
  /// 담기 위한 @@unique([userId, stockCode]) 때문에 비정규화된 관계다.
  virtualPortfolioStocks VirtualPortfolioStock[]

  favoriteStocks FavoriteStock[]
  hiddenStocks   HiddenStock[]
  profilePic     ProfilePic?
  loginSessions  LoginSession[]

  @@map("users")
}

model LoginSession {
  id               Int      @id @default(autoincrement())
  refreshTokenHash String
  expiresAt        DateTime

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("login_sessions")
}

model TossAccount {
  id        Int    @id @default(autoincrement())
  apiKey    String
  secretKey String

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("toss_accounts")
}

model OAuthProvider {
  id       Int    @id @default(autoincrement())
  provider String @unique

  oauthAccounts OAuth[]

  @@map("oauth_provider")
}

model OAuth {
  id          Int    @id @default(autoincrement())
  providerKey String

  userId Int
  user   User @relation(fields: [userId], references: [id])

  providerId Int
  provider   OAuthProvider @relation(fields: [providerId], references: [id])

  createdAt DateTime @default(now())

  @@unique([providerId, providerKey])
  @@map("oauth")
}

model Image {
  id       Int    @id @default(autoincrement())
  imageUrl String

  createdAt DateTime @default(now())

  profilePic ProfilePic?
  snapshot   Snapshot?

  @@map("images")
}

model ProfilePic {
  imageId Int   @id
  image   Image @relation(fields: [imageId], references: [id])

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  @@map("profile_pics")
}

model Snapshot {
  imageId Int   @id
  image   Image @relation(fields: [imageId], references: [id])

  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id])

  @@map("snapshot")
}

model Trade {
  id BigInt @id @default(autoincrement())

  externalTradeId String    @unique
  tradeType       TradeType
  corpCode        String
  corpName        String
  tradedAt        DateTime
  price           Decimal   @db.Decimal(15, 2)
  quantity        Int
  totalPrice      Decimal   @db.Decimal(20, 2)
  realizedProfit  Decimal?  @db.Decimal(20, 2)
  returnRate      Decimal?  @db.Decimal(6, 2)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  currenciesId Int
  currency     Currency @relation(fields: [currenciesId], references: [id])

  ordersId Int
  order    Order @relation(fields: [ordersId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, tradedAt])
  @@index([userId, tradeType, tradedAt])
  @@map("trades")
}

enum GoalHoldPeriod {
  SHORT_TERM
  MID_TERM
  LONG_TERM
  CUSTOM
}

model Diary {
  id               Int       @id @default(autoincrement())
  type             TradeType
  date             DateTime  @db.Date
  corpCode         String    @db.VarChar(10)
  corpName         String    @db.VarChar(100)
  perAtOrder       Decimal?  @db.Decimal(15, 2)
  pbrAtOrder       Decimal?  @db.Decimal(15, 2)
  marketCapAtOrder Decimal?  @db.Decimal(20, 2)
  deletedAt        DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  buyDiary  BuyDiary?
  sellDiary SellDiary?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, deletedAt])
  @@index([userId, deletedAt, date])
  @@map("diaries")
}

model BuyDiary {
  diaryId Int   @id
  diary   Diary @relation(fields: [diaryId], references: [id])

  buyReason            String          @db.Text
  goalPrice            Decimal?        @db.Decimal(15, 2)
  goalHoldPeriod       GoalHoldPeriod?
  customGoalHoldPeriod String?         @db.VarChar(255)
  emotion              Int
  memo                 String?         @db.Text

  @@map("buy_diaries")
}

enum SellReasonCode {
  GOAL_REACHED
  STOP_LOSS
  REBALANCING
  PROFIT_TAKING
  OTHER
}

enum GoalEvaluationCode {
  KEPT_GOAL
  SOLD_TOO_EARLY
  SOLD_TOO_LATE
  EMOTIONAL_SELL
  AS_PLANNED
  OTHER
}

model SellDiary {
  diaryId Int   @id
  diary   Diary @relation(fields: [diaryId], references: [id])

  sellReasonCode       SellReasonCode
  sellReasonDetail     String?             @db.VarChar(191)
  goalEvaluationCode   GoalEvaluationCode?
  goalEvaluationDetail String?             @db.VarChar(191)
  emotion              Int
  memo                 String?             @db.Text

  @@map("sell_diaries")
}

model VirtualPortfolio {
  id        Int    @id @default(autoincrement())
  name      String
  sortOrder Int    @default(0)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  stocks VirtualPortfolioStock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, sortOrder])
  @@map("virtual_portfolios")
}

model VirtualPortfolioStock {
  id        Int    @id @default(autoincrement())
  stockCode String

  virtualPortfolioId Int
  virtualPortfolio   VirtualPortfolio @relation(fields: [virtualPortfolioId], references: [id])

  /// 같은 종목을 여러 가상계좌에 중복해서 담지 못하게 하는 제약의 기준.
  /// 계좌를 타고 올라가면 알 수 있는 값이지만, UNIQUE는 한 테이블 안에서만
  /// 걸 수 있어 비정규화한다.
  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 사용자당 종목 1회. (virtualPortfolioId, stockCode)보다 상위 제약이라
  /// 그쪽은 따로 두지 않는다.
  @@unique([userId, stockCode])
  @@index([virtualPortfolioId])
  @@map("virtual_portfolio_stocks")
}

model FavoriteStock {
  id        Int    @id @default(autoincrement())
  stockCode String
  stockName String

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, stockCode])
  @@map("favorite_stocks")
}

model HiddenStock {
  id          Int      @id @default(autoincrement())
  stockCode   String
  stockName   String
  hiddenUntil DateTime

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, stockCode])
  @@map("hidden_stocks")
}

/// 토스증권의 시장별 전체 종목 목록을 동기화한 공용 종목 마스터.
/// 사용자별 관심·숨김 기록과 분리하며, 이름 및 종목 코드 검색에 사용한다.
model Stock {
  id            Int     @id @default(autoincrement())
  stockCode     String  @unique @db.VarChar(20)
  name          String  @db.VarChar(100)
  market        String  @db.VarChar(20)
  securityType  String  @db.VarChar(30)
  isCommonShare Boolean
  isinCode      String? @db.VarChar(20)
  isActive      Boolean @default(true)

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([market, isActive])
  @@map("stocks")
}

enum OrderType {
  MARKET
  LIMIT
}

enum TradeType {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  PARTIALLY_FILLED
  FILLED
  CANCELED
  REJECTED
  EXPIRED
}

enum OrderCategory {
  GENERAL
  CONDITIONAL
}

model Order {
  id Int @id @default(autoincrement())

  orderType        OrderType     @default(MARKET)
  orderCategory    OrderCategory @default(GENERAL)
  tradeType        TradeType
  quantity         Int
  price            Decimal?      @db.Decimal(15, 2)
  status           OrderStatus   @default(PENDING)
  corpCode         String        @db.VarChar(10)
  corpName         String        @db.VarChar(100)
  perAtOrder       Decimal?      @db.Decimal(15, 2)
  pbrAtOrder       Decimal?      @db.Decimal(15, 2)
  marketCapAtOrder Decimal?      @db.Decimal(20, 2)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  currenciesId Int
  currency     Currency @relation(fields: [currenciesId], references: [id])

  trades         Trade[]
  diaries        Diary[]
  orderCondition OrderCondition?
  snapshot       Snapshot?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderCondition {
  id           Int      @id @default(autoincrement())
  triggerPrice Decimal
  expiredAt    DateTime

  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_conditions")
}

model Currency {
  id       Int    @id @default(autoincrement())
  currency String

  orders Order[]
  trades Trade[]

  createdAt DateTime @default(now())

  @@map("currencies")
}

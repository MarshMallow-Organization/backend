# .env 템플릿. 복사해서 값을 채운다.
#   cp .env.example .env
#
# 실제 .env는 .gitignore 대상이라 커밋되지 않는다.
# 새 환경변수를 추가하면 이 파일에도 키를 함께 추가한다.

APP_ENV=local
APP_NAME=marshmallow-api-server
APP_VERSION=1.0.0
PORT=3000

# DB — docker-compose의 cgateDB (호스트 3310 -> 컨테이너 3306)
DB_HOSTNAME=127.0.0.1
DB_PORT=3310
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=cgate

# Prisma CLI 전용 (prisma.config.ts에서 읽음)
# mysql://<user>:<password>@<host>:<port>/<database>
PRISMA_URL=

# 임시 스텁 인증(StubAuthGuard). 명시적으로 켜야만 동작한다.
# 미설정이면 인증이 필요한 모든 API가 401이 되므로 로컬 개발에서는 true로 둔다.
# 실제 JWT 가드가 붙으면 가드와 함께 삭제한다.
STUB_AUTH_ENABLED=true

# 임시 보유종목 스텁(HoldingsProvider). 명시적으로 켜야만 동작한다.
# 미설정이면 /assets/summary, /assets/holdings, /assets/portfolios/:id가
# 503(HOLDINGS_UNAVAILABLE)이 되므로 로컬 개발에서는 true로 둔다.
# 실제 토스 holdings 연동(GET /api/v1/holdings)이 붙으면 함께 삭제한다.
HOLDINGS_STUB_ENABLED=true

# JWT — 로컬은 아무 문자열이나, 운영은 반드시 별도 값으로 교체
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=14d

# Google OAuth (POST /auths/google) — 팝업 방식이라 콜백 URL은 필요 없다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Toss(토스) Open API
# TOSS_CLIENT_KEY와 TOSS_CLIENT_SECRET 키만 작성
TOSS_ACCESS_TOKEN=
TOSS_CLIENT_KEY=
TOSS_CLIENT_SECRET=

# AWS KMS (TossAccount.secretKey 등 민감정보 암/복호화에 사용)
# 로컬 개발은 IAM 사용자 액세스키/시크릿을 쓴다. 배포 환경에서 IAM 롤을
# 쓰면 AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY는 비워둔다.
AWS_REGION=
AWS_KMS_KEY_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 토스 개발자 모드 (로컬 개발 중 실제 증권사 실거래 차단 및 Mock 모의 주문 처리)
# - true: 개발자 모드 활성화 (로컬 개발/테스트용)
# - false: 개발자 모드 비활성화 (운영 배포 시 실제 토스 증권 서버 연동)
TOSS_DEVELOPER_MODE=true

# KIS(한국투자증권) Open API
# KIS_APP_KEY와 KIS_APP_SECRET만 작성.
KIS_ACCESS_TOKEN=
KIS_APPROVAL_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
# 실시간 웹소켓(OrdersWatcherService) 부팅 시 자동 연결. orders 도메인 배선 후 true.
KIS_WS_ENABLED=false

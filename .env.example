# .env 템플릿. 복사해서 값을 채운다.
#   cp .env.example .env
#
# 실제 .env는 .gitignore 대상이라 커밋되지 않는다.
# 새 환경변수를 추가하면 이 파일에도 키를 함께 추가한다.

APP_ENV=local
APP_NAME=marshmallow-api-server
APP_VERSION=1.0.0
PORT=3000

# DB — docker-compose의 cgateDB (호스트 3310 -> 컨테이너 3306)
DB_HOSTNAME=127.0.0.1
DB_PORT=3310
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=cgate

# Prisma CLI 전용 (prisma.config.ts에서 읽음)
# mysql://<user>:<password>@<host>:<port>/<database>
PRISMA_URL=

# 임시 스텁 인증(StubAuthGuard). 명시적으로 켜야만 동작한다.
# 미설정이면 인증이 필요한 모든 API가 401이 되므로 로컬 개발에서는 true로 둔다.
# 실제 JWT 가드가 붙으면 가드와 함께 삭제한다.
STUB_AUTH_ENABLED=true

# JWT — 로컬은 아무 문자열이나, 운영은 반드시 별도 값으로 교체
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=14d

# Google OAuth — 아직 미사용
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auths/google/callback

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Toss Open API 곧 사용할 예정 (client key와 secret 만으로 토큰을 발급받는 로직 구현)
# 클라이언트 키와 secret 키만 작성해주시면 됩니다. 물론 해당 파일 말고 .env 파일에만!!
TOSS_ACCESS_TOKEN=
TOSS_CLIENT_KEY=
TOSS_CLIENT_SECRET=

# LocalEncryptionAdapter 대칭키(hex 64자리 = 32바이트). `openssl rand -hex 32`로 생성.
# 실제 AWS KMS 키(ARN)가 준비되면 KMS 어댑터로 교체하고 이 값은 삭제한다.
LOCAL_ENCRYPTION_KEY=
